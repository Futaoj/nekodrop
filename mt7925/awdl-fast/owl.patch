+#ifdef _WIN32
+static void mt7925_discovery_schedule(struct daemon_state *state, uint64_t now, double in,
+                                       bool *send, uint64_t *retry_us) {
+	void *head;
+	if (circular_buf_get(state->tx_queue_multicast, &head, 1) ||
+	    !mt7925_discovery_is_mdns(buf_data(head), buf_len(head)))
+		return;
+	const bool deferred = state->mt7925_discovery_deferred_head == head;
+	if (deferred && now < state->mt7925_discovery_deferred_until) {
+		/* Host-ready callbacks can revisit the queue before the armed timer. */
+		*send = false;
+		*retry_us = state->mt7925_discovery_deferred_until - now;
+		return;
+	}
+
+	const struct awdl_state *awdl = &state->awdl_state;
+	struct awdl_peer *master;
+	if (awdl_chan_num(awdl->channel.current, awdl->channel.enc) != MT7925_DISCOVERY_CHANNEL ||
+	    !compare_ether_addr(&awdl->self_address, &awdl->election.sync_addr) ||
+	    awdl_peer_get(awdl->peers.peers, &awdl->election.sync_addr, &master) < 0 ||
+	    !master->is_valid || !mt7925_discovery_fresh(now, master->mt7925_sync_rx_us) ||
+	    !mt7925_discovery_fresh(now, master->mt7925_schedule_rx_us) ||
+	    master->mt7925_sync_start_us != awdl->sync.last_update) {
+		return;
+	}
+
+	const uint16_t eaw = awdl_sync_current_eaw(now, &awdl->sync);
+	const unsigned slot = eaw % AWDL_CHANSEQ_LENGTH;
+	const unsigned own_channel = awdl_chan_num(awdl->channel.sequence[slot], awdl->channel.enc);
+	const unsigned peer_channel = awdl_chan_num(master->sequence[slot], AWDL_CHAN_ENC_OPCLASS);
+	const uint64_t remaining = awdl_sync_next_aw_us(now, &awdl->sync);
+	if (*send) {
+		const unsigned next_slot = (slot + 1) % AWDL_CHANSEQ_LENGTH;
+		const unsigned next_own = awdl_chan_num(awdl->channel.sequence[next_slot], awdl->channel.enc);
+		const unsigned next_peer = awdl_chan_num(master->sequence[next_slot], AWDL_CHAN_ENC_OPCLASS);
+		const uint64_t sync = master->mt7925_sync_rx_us;
+		const uint64_t schedule = master->mt7925_schedule_rx_us;
+		const uint64_t wait = remaining + ieee80211_tu_to_usec(AWDL_MULTICAST_GUARD_TU);
+		/* A single table entry also rules out unclassified neighbors. */
+		if (mt7925_discovery_defer_legacy(awdl_peers_length(awdl->peers.peers), deferred, peer_channel,
+		                                 next_own, next_peer, now + wait, sync < schedule ? sync : schedule)) {
+			state->mt7925_discovery_deferred_head = head;
+			state->mt7925_discovery_deferred_until = now + wait;
+			*send = false;
+			*retry_us = wait;
+		}
+		return;
+	}
+	const bool already_used = state->mt7925_discovery_alt_eaw == eaw &&
+	                          mt7925_discovery_fresh(now, state->mt7925_discovery_alt_us);
+	if (!already_used && mt7925_discovery_in_window(own_channel, peer_channel, in)) {
+		state->mt7925_discovery_alt_us = now;
+		state->mt7925_discovery_alt_eaw = eaw;
+		log_trace("mt7925 discovery_window selected=1 slot=%u channel=44 remaining_us=%lu",
+		          slot, (unsigned long) remaining);
+		*send = true;
+	} else if (in <= 0) {
+		/* Retry at the next slot's inner guard, not at the current slot's phase. */
+		*retry_us = remaining + ieee80211_tu_to_usec(AWDL_MULTICAST_GUARD_TU);
+	}
+}
