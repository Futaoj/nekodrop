; SPDX-License-Identifier: MIT
; User-mode register proxy for the Intel Wi-Fi 6/6E cards nekodrop's radio drives:
; AX201 and 9560-class on Qu/QuZ, AX200, and the AX210 family (AX210/AX211/AX411).
; Adapted from winawdl's RTL8852CE proxy. Matches only the generic device IDs,
; which rank below Intel's own (with SUBSYS), so adding it takes over nothing:
; NekoDropService (or scripts	ake-card.ps1) binds it to the card explicitly.

[Version]
Signature   = "$Windows NT$"
Class       = WinAwdlRadio
ClassGuid   = {42c93386-3172-4834-9a73-d5dbe38443f8}
Provider    = %Provider%
CatalogFile = winawdl_regproxy.cat
DriverVer   = 11/16/2026,0.1.0.0
PnpLockdown = 1

[ClassInstall32]
AddReg = Class_AddReg

[Class_AddReg]
HKR,,,,%ClassName%
HKR,,Icon,,"-5"

[Manufacturer]
%Provider% = Models, NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_43F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_A0F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_02F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_06F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_34F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_3DF0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_4DF0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_2723
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_2725
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_7A70
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_7AF0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_51F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_51F1
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_54F0
%DeviceDesc% = RegProxy, PCI\VEN_8086&DEV_7F70
; MediaTek MT7922 / AMD RZ616 and MT7921 / AMD RZ608
%MtkDeviceDesc% = RegProxy, PCI\VEN_14C3&DEV_0616
%MtkDeviceDesc% = RegProxy, PCI\VEN_14C3&DEV_7922
%MtkDeviceDesc% = RegProxy, PCI\VEN_0B48&DEV_7922
%MtkDeviceDesc% = RegProxy, PCI\VEN_14C3&DEV_7961
%MtkDeviceDesc% = RegProxy, PCI\VEN_14C3&DEV_0608

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
winawdl_regproxy.dll = 1

[DestinationDirs]
RegProxy_Copy = 13

[RegProxy.NT]
CopyFiles = RegProxy_Copy
Include   = WUDFRD.inf
Needs     = WUDFRD.NT

[RegProxy_Copy]
winawdl_regproxy.dll

[RegProxy.NT.HW]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.HW
AddReg  = RegProxy_HwAddReg

[RegProxy_HwAddReg]
; Device object reachable by SYSTEM and Administrators only.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[RegProxy.NT.Services]
; The reflector as the function driver, added here (SPSVCINST_ASSOCSERVICE in
; 0x1fa), as Microsoft documents for Windows 10 and earlier. Include/Needs of
; WUDFRD.NT.Services left the device without a function driver on Windows 10
; 22H2: code 31, status 0xC0000494 STATUS_PNP_FUNCTION_DRIVER_REQUIRED (#18, #12).
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[RegProxy.NT.Wdf]
UmdfService               = winawdl_regproxy, RegProxy_Umdf
UmdfServiceOrder          = winawdl_regproxy
UmdfDirectHardwareAccess  = AllowDirectHardwareAccess
UmdfRegisterAccessMode    = RegisterAccessUsingUserModeMapping

[RegProxy_Umdf]
UmdfLibraryVersion = 2.31.0
ServiceBinary      = %13%\winawdl_regproxy.dll

[Strings]
Provider   = "winairdrop project"
ClassName  = "winawdl user-space radios"
DeviceDesc = "Intel Wi-Fi user-space register proxy (nekodrop)"
MtkDeviceDesc = "MediaTek Wi-Fi user-space register proxy (nekodrop)"
DiskName   = "winawdl register proxy"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
