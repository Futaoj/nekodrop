diff --git a/awdl/tests/frame_fixup_test.c b/awdl/tests/frame_fixup_test.c
index b3e91d7..6cc9f3d 100644
--- a/awdl/tests/frame_fixup_test.c
+++ b/awdl/tests/frame_fixup_test.c
@@ -126,5 +126,30 @@ int main(void) {
 	       "a frame without HT capabilities gains none for VHT");
 	frame_fixup_announce(0, 0, 20);
 
+	/* E138's two receive chains do not add a transmit chain or HE support. */
+	static const uint8_t data_path[] = {12, 15, 0, 0, 0x80, [17] = 0};
+	for (int rx_streams = 1; rx_streams <= 2; ++rx_streams) {
+		int pos = start_frame(frame, 0);
+		int ht = pos + 3;
+		pos = add(frame, pos, ht_tlv, sizeof(ht_tlv));
+		int dp = pos + 3;
+		pos = add(frame, pos, data_path, sizeof(data_path));
+		frame_fixup_set_e138(1);
+		frame_fixup_set_he(1);
+		frame_fixup_announce(rx_streams == 2, 1, 80);
+		int length = frame_fixup_sent(frame, pos, sizeof(frame));
+		expect(length == pos + 17 && frame[pos + 9] == (rx_streams == 2 ? 0xfa : 0xfe) &&
+		       frame[pos + 10] == 0xff && frame[pos + 13] == 0xfd && frame[pos + 14] == 0xff,
+		       "E138 VHT RX follows configured NSS, TX stays one stream MCS 0..8");
+		expect((frame[pos + 5] & 3) == 2 && (frame[ht + 3] & 8),
+		       "E138 advertises native VHT and HT receive sizes");
+		expect(frame[ht + 6] == (rx_streams == 2 ? 0xff : 0) && !(frame[ht + 2] & 0x80) &&
+		       frame[dp + 14] == 0,
+		       "E138 HT receive streams and HE flag agree with the radio");
+		frame_fixup_set_e138(0);
+		expect(frame_fixup_sent(frame, pos, sizeof(frame)) == pos + 17 &&
+		       (frame[pos + 5] & 3) == 0 && frame[pos + 13] == frame[pos + 9] && frame[dp + 14] == 1,
+		       "unmarked radios keep their original VHT transmit and HE flags");
+	}
 	return failures ? 1 : 0;
 }
diff --git a/awdl/tests/mt7925_discovery_test.c b/awdl/tests/mt7925_discovery_test.c
new file mode 100644
index 0000000..bbcc75e
--- /dev/null
+++ b/awdl/tests/mt7925_discovery_test.c
@@ -0,0 +1,75 @@
+/* Offline test. Compile with awdl/win from the patched winawdl tree on the include path. */
+#include <stdio.h>
+#define CHECK(expr) do { if (!(expr)) { fprintf(stderr, "failed: %s\n", #expr); return 1; } } while (0)
+
+#include "mt7925_discovery_window.h"
+
+int main(void) {
+	uint8_t tx[8 + 24] = {0, 0, 8, 0};
+	CHECK(mt7925_pipe_control(tx, sizeof(tx))); /* management */
+	tx[8] = 0x88; /* unicast QoS data */
+	CHECK(!mt7925_pipe_control(tx, sizeof(tx)));
+	tx[12] = 1;
+	CHECK(mt7925_pipe_control(tx, sizeof(tx))); /* multicast data */
+	CHECK(!mt7925_pipe_control(tx, sizeof(tx) - 1));
+	tx[3] = 1; /* truncated radiotap header */
+	CHECK(!mt7925_pipe_control(tx, sizeof(tx)));
+
+	uint8_t frame[74] = {0x33, 0x33, 0, 0, 0, 0xfb};
+	frame[12] = 0x86;
+	frame[13] = 0xdd;
+	frame[14] = 0x60;
+	frame[19] = 20;
+	frame[20] = 17;
+	frame[38] = 0xff;
+	frame[39] = 0x02;
+	frame[53] = 0xfb;
+	frame[56] = 0x14;
+	frame[57] = 0xe9;
+	frame[59] = 20;
+	CHECK(mt7925_discovery_is_mdns(frame, sizeof(frame)));
+	CHECK(!mt7925_discovery_is_mdns(frame, sizeof(frame) - 1));
+	frame[57]++;
+	CHECK(!mt7925_discovery_is_mdns(frame, sizeof(frame)));
+	frame[57]--;
+	frame[20] = 58; /* ICMPv6 multicast never takes the alternate window. */
+	CHECK(!mt7925_discovery_is_mdns(frame, sizeof(frame)));
+	frame[20] = 17;
+	frame[53] = 0xfa;
+	CHECK(!mt7925_discovery_is_mdns(frame, sizeof(frame)));
+
+	CHECK(mt7925_fast_enabled(0x25, 44, 80, true));
+	CHECK(mt7925_fast_enabled(0x25, 149, 80, true));
+	CHECK(!mt7925_fast_enabled(0, 149, 80, true));
+	CHECK(!mt7925_fast_enabled(0x25, 149, 20, true));
+	CHECK(!mt7925_fast_enabled(0x25, 149, 80, false));
+	CHECK(mt7925_extended_discovery(true, 44));
+	CHECK(!mt7925_extended_discovery(true, 149));
+	CHECK(!mt7925_extended_discovery(false, 44));
+	CHECK(!mt7925_fast_enabled(0x25, 44, 20, true));
+	CHECK(!mt7925_fast_enabled(0x25, 44, 80, false));
+	CHECK(!mt7925_fast_enabled(0, 44, 80, true));
+	CHECK(!mt7925_fast_enabled(0x25, 36, 80, true));
+
+	CHECK(mt7925_discovery_in_window(44, 44, 0));
+	CHECK(!mt7925_discovery_in_window(44, 149, 0));
+	CHECK(!mt7925_discovery_in_window(36, 44, 0));
+	CHECK(!mt7925_discovery_in_window(44, 44, 0.001));
+	CHECK(!mt7925_discovery_in_window(44, 44, -0.001));
+	CHECK(mt7925_discovery_fresh(513000, 1000));
+	CHECK(!mt7925_discovery_fresh(513001, 1000));
+	CHECK(!mt7925_discovery_fresh(999, 1000));
+	CHECK(!mt7925_discovery_fresh(1000, 0));
+
+	/* A confirmed legacy 149 slot may give way to only the adjacent 44 slot. */
+	CHECK(mt7925_discovery_defer_legacy(1, false, 149, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, true, 149, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(2, false, 149, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 0, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 0xff, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 44, 44, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 149, 36, 44, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 149, 44, 149, 513000, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 149, 44, 44, 513001, 1000));
+	CHECK(!mt7925_discovery_defer_legacy(1, false, 149, 44, 44, 513000, 0));
+}
diff --git a/awdl/tests/mt7925_radio_test.c b/awdl/tests/mt7925_radio_test.c
new file mode 100644
index 0000000..7522add
--- /dev/null
+++ b/awdl/tests/mt7925_radio_test.c
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Compile the host's radio client against private Win32 objects. The pipe,
+ * mapping, and event names all include the test PID, including negative cases. */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "radio_link.h"
+
+static char pipe_name[80], map_name[80], rx_name[80], tx_name[80];
+static HANDLE test_open_map(DWORD access, BOOL inherit, const char *name) {
+	if (strcmp(name, "Local\\nekodrop-radio-shm-v1"))
+		return NULL;
+	return OpenFileMappingA(access, inherit, map_name);
+}
+static HANDLE test_open_event(DWORD access, BOOL inherit, const char *name) {
+	if (!strcmp(name, "Local\\nekodrop-radio-shm-rx-v1"))
+		return OpenEventA(access, inherit, rx_name);
+	if (!strcmp(name, "Local\\nekodrop-radio-shm-tx-v1"))
+		return OpenEventA(access, inherit, tx_name);
+	return NULL;
+}
+#undef RADIO_LINK_PIPE_NAME
+#define RADIO_LINK_PIPE_NAME pipe_name
+#define OpenFileMappingA test_open_map
+#define OpenEventA test_open_event
+#include "../win/radio_client.c"
+#undef OpenFileMappingA
+#undef OpenEventA
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "line %d: %s failed\n", __LINE__, #x); exit(1); } } while (0)
+
+static DWORD WINAPI open_client(void *out) {
+	*(struct radio_client **)out = radio_client_open(NULL);
+	return 0;
+}
+
+static void exercise(uint8_t backend, uint8_t channel, uint8_t width, uint8_t cap,
+                     int expected, struct radio_shm_layout *shared) {
+	struct radio_client *client = NULL;
+	HANDLE pipe = CreateNamedPipeA(pipe_name, PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE,
+		PIPE_TYPE_BYTE | PIPE_REJECT_REMOTE_CLIENTS, 1, 65536, 65536, 0, NULL);
+	CHECK(pipe != INVALID_HANDLE_VALUE);
+	HANDLE worker = CreateThread(NULL, 0, open_client, &client, 0, NULL);
+	CHECK(worker);
+	CHECK(ConnectNamedPipe(pipe, NULL) || GetLastError() == ERROR_PIPE_CONNECTED);
+	struct radio_link_hello hello = {RADIO_LINK_VERSION, channel, width, {cap, backend}};
+	struct radio_link_header greeting = {RADIO_LINK_HELLO, 0, sizeof(hello)};
+	DWORD done;
+	CHECK(WriteFile(pipe, &greeting, sizeof(greeting), &done, NULL) && done == sizeof(greeting));
+	CHECK(WriteFile(pipe, &hello, sizeof(hello), &done, NULL) && done == sizeof(hello));
+	CHECK(WaitForSingleObject(worker, 5000) == WAIT_OBJECT_0);
+	CloseHandle(worker);
+	CHECK((client != NULL) == expected);
+	if (client) {
+		CHECK(radio_client_channel(client) == channel && radio_client_width_mhz(client) == width);
+		CHECK(radio_client_mt7925_fast(client) == (backend == MT7925_DISCOVERY_BACKEND));
+		uint8_t qos[32] = {0, 0, 8, 0, 0, 0, 0, 0, 0x88};
+		if (backend == MT7925_DISCOVERY_BACKEND) {
+			CHECK(shared->client_ready);
+			CHECK(radio_client_send(client, RADIO_LINK_TX, qos, sizeof(qos)) == 0);
+			uint32_t bytes;
+			memcpy(&bytes, shared->tx.data, 4);
+			CHECK(bytes == sizeof(qos) && shared->tx.write_pos == 4 + sizeof(qos));
+			CHECK(!memcmp(shared->tx.data + 4, qos, bytes));
+			memcpy(shared->rx.data, shared->tx.data, 4 + bytes);
+			InterlockedExchange(&shared->rx.write_pos, 4 + bytes);
+			uint8_t received[RADIO_CLIENT_MAX_FRAME];
+			CHECK(radio_client_pop(client, received) == (int)bytes);
+			CHECK(!memcmp(received, qos, bytes));
+			qos[8] = 0xd0; /* AWDL management goes through the pipe. */
+		}
+		CHECK(radio_client_send(client, RADIO_LINK_TX, qos, sizeof(qos)) == 0);
+		DWORD available;
+		CHECK(PeekNamedPipe(pipe, NULL, 0, NULL, &available, NULL));
+		CHECK(available == sizeof(struct radio_link_header) + sizeof(qos));
+		uint8_t record[sizeof(struct radio_link_header) + sizeof(qos)];
+		CHECK(ReadFile(pipe, record, sizeof(record), &done, NULL) && done == sizeof(record));
+		struct radio_link_header header;
+		memcpy(&header, record, sizeof(header));
+		CHECK(header.type == RADIO_LINK_TX && header.length == sizeof(qos));
+		CHECK(!memcmp(qos, record + sizeof(header), sizeof(qos)));
+	}
+	DisconnectNamedPipe(pipe);
+	CloseHandle(pipe);
+	radio_client_close(client);
+	CHECK(!shared->client_ready);
+}
+
+int main(void) {
+	DWORD pid = GetCurrentProcessId();
+	snprintf(pipe_name, sizeof(pipe_name), "\\\\.\\pipe\\awdld-test-%lu", pid);
+	snprintf(map_name, sizeof(map_name), "Local\\awdld-test-map-%lu", pid);
+	snprintf(rx_name, sizeof(rx_name), "Local\\awdld-test-rx-%lu", pid);
+	snprintf(tx_name, sizeof(tx_name), "Local\\awdld-test-tx-%lu", pid);
+	HANDLE map = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(struct radio_shm_layout), map_name);
+	CHECK(map && GetLastError() != ERROR_ALREADY_EXISTS);
+	HANDLE rx = CreateEventA(NULL, TRUE, FALSE, rx_name), tx = CreateEventA(NULL, TRUE, FALSE, tx_name);
+	CHECK(rx && tx);
+	struct radio_shm_layout *shared = MapViewOfFile(map, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(*shared));
+	CHECK(shared);
+	shared->magic = RADIO_SHM_MAGIC;
+	shared->version = RADIO_SHM_VERSION;
+	for (unsigned i = 0; i < 2; i++) {
+		memset(&shared->rx, 0, sizeof(shared->rx));
+		memset(&shared->tx, 0, sizeof(shared->tx));
+		exercise(0x25, i == 0 ? 44 : 149, 80, RADIO_LINK_CAP_SHM_LOCAL, 1, shared);
+	}
+	exercise(0x25, 44, 80, 0, 0, shared);
+	exercise(0x25, 44, 20, RADIO_LINK_CAP_SHM_LOCAL, 0, shared);
+	shared->version++; /* HELLO advertises SHM, but the mapped ABI is incompatible. */
+	exercise(0x25, 149, 80, RADIO_LINK_CAP_SHM_LOCAL, 0, shared);
+	exercise(0, 6, 20, 0, 1, shared); /* Existing pipe-only radio */
+	UnmapViewOfFile(shared);
+	CloseHandle(tx);
+	CloseHandle(rx);
+	CloseHandle(map);
+	puts("radio HELLO and transport checks passed");
+	return 0;
+}
diff --git a/awdl/tests/mt7925_rx_test.c b/awdl/tests/mt7925_rx_test.c
new file mode 100644
index 0000000..1502574
--- /dev/null
+++ b/awdl/tests/mt7925_rx_test.c
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "radio_client.h"
+#include "rx.h"
+#include "wire.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+	fprintf(stderr, "RX check failed at line %d: %s\n", __LINE__, #condition); exit(1); \
+} } while (0)
+
+static const struct ether_addr sender = {{2, 1, 2, 3, 4, 5}};
+static const struct ether_addr receiver = {{2, 6, 7, 8, 9, 10}};
+static const uint8_t llc_awdl[16] = {0xaa, 0xaa, 3, 0, 0, 0, 8, 0, 3, 4, 0, 0, 0, 0, 0x86, 0xdd};
+static uint8_t record[RADIO_CLIENT_MAX_FRAME];
+
+static void check_receive(struct awdl_state *state, int count, int ip_bytes, int aggregate,
+			  int channel, int ht_control, int output_capacity) {
+	/* Match the flags, channel and dBm radiotap fields emitted by the E138 radio. */
+	memset(record, 0, sizeof(record));
+	record[2] = 16;
+	record[4] = 0x2a;
+	unsigned mhz = 5000 + 5 * channel;
+	record[10] = (uint8_t)mhz;
+	record[11] = (uint8_t)(mhz >> 8);
+	record[12] = 0x40;
+	record[13] = 1;
+	record[14] = (uint8_t)-48;
+	uint8_t *mac = record + 16;
+	mac[0] = 0x88;
+	mac[1] = ht_control ? 0x80 : 0;
+	memcpy(mac + 4, &receiver, 6);
+	memcpy(mac + 10, &sender, 6);
+	memcpy(mac + 16, &AWDL_BSSID, 6);
+	mac[24] = aggregate ? 0x80 : 0;
+	size_t pos = 16 + 26 + (ht_control ? 4 : 0);
+	for (int i = 0; i < count; i++) {
+		size_t subframe = pos;
+		CHECK(pos + 14 + sizeof(llc_awdl) + ip_bytes + 3 <= sizeof(record));
+		if (aggregate) {
+			memcpy(record + pos, &receiver, 6);
+			memcpy(record + pos + 6, &sender, 6);
+			unsigned len = (unsigned)sizeof(llc_awdl) + ip_bytes;
+			record[pos + 12] = (uint8_t)(len >> 8);
+			record[pos + 13] = (uint8_t)len;
+			pos += 14;
+		}
+		memcpy(record + pos, llc_awdl, sizeof(llc_awdl));
+		pos += sizeof(llc_awdl);
+		memset(record + pos, 0, 40);
+		record[pos] = 0x60;
+		record[pos + 4] = (uint8_t)((ip_bytes - 40) >> 8);
+		record[pos + 5] = (uint8_t)(ip_bytes - 40);
+		memset(record + pos + 40, i + 1, ip_bytes - 40);
+		pos += ip_bytes;
+		if (aggregate && i + 1 < count)
+			pos += (4 - (pos - subframe) % 4) % 4;
+	}
+	if (count > 16)
+		CHECK(pos > 4096);
+	const struct buf *frame = buf_new_const(record, (int)pos);
+	CHECK(frame);
+	struct buf *packets[32];
+	CHECK(output_capacity <= 32);
+	struct awdl_rx_frames out = {packets, packets + output_capacity};
+	int result = awdl_rx(frame, &out, state);
+	CHECK(result == (output_capacity < count ? RX_UNEXPECTED_VALUE : RX_OK));
+	int decoded = (int)(out.next - packets);
+	CHECK(decoded == (output_capacity < count ? output_capacity : count));
+	for (int i = 0; i < decoded; i++) {
+		CHECK(buf_len(packets[i]) == 14 + ip_bytes);
+		const uint8_t *eth = buf_data(packets[i]);
+		CHECK(!memcmp(eth, &receiver, 6) && !memcmp(eth + 6, &sender, 6));
+		CHECK(eth[12] == 0x86 && eth[13] == 0xdd && eth[14] == 0x60);
+		for (int j = 40; j < ip_bytes; j++)
+			CHECK(eth[14 + j] == (uint8_t)(i + 1));
+		buf_free(packets[i]);
+	}
+	buf_free(frame);
+}
+
+int main(void) {
+	struct awdl_state state = {0};
+	state.self_address = receiver;
+	awdl_peer_state_init(&state.peers);
+	CHECK(awdl_peer_add(state.peers.peers, &sender, 1, NULL, NULL) >= 0);
+	check_receive(&state, 1, 1500, 0, 44, 0, 1);   /* Ordinary QoS data */
+	check_receive(&state, 1, 1450, 1, 149, 0, 1);   /* Single MSDU in an aggregate */
+	check_receive(&state, 20, 515, 1, 149, 1, 20);  /* Complete large A-MSDU and HT Control */
+	check_receive(&state, 20, 515, 1, 44, 0, 19);  /* Bounded output batch */
+	awdl_peers_free(state.peers.peers);
+	puts("MT7925 receive frame checks passed");
+	return 0;
+}
