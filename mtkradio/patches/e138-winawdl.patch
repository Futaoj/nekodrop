diff --git a/awdl/win/mt7925_discovery_window.h b/awdl/win/mt7925_discovery_window.h
new file mode 100644
index 0000000..bd4a5d6
--- /dev/null
+++ b/awdl/win/mt7925_discovery_window.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define MT7925_DISCOVERY_BACKEND 0x25u
+#define MT7925_DISCOVERY_CHANNEL 44u
+#define MT7925_DISCOVERY_FRESH_US 512000u
+
+static inline bool mt7925_fast_enabled(uint8_t backend, uint8_t channel, uint8_t width, bool shm) {
+	return backend == MT7925_DISCOVERY_BACKEND && (channel == 44 || channel == 149) &&
+	       width == 80 && shm;
+}
+
+/* Management and group frames share the ordered command pipe. Unicast data
+ * uses the TX ring. The E138 radio polls the command pipe before bulk data. */
+static inline bool mt7925_pipe_control(const uint8_t *payload, size_t length) {
+	if (length < 8 || payload[0] != 0)
+		return false;
+	size_t header = (size_t)payload[2] | (size_t)payload[3] << 8;
+	if (header < 8 || header > length || length - header < 24)
+		return false;
+	const uint8_t *frame = payload + header;
+	return (frame[0] & 0x0c) != 8 || (frame[4] & 1);
+}
+
+/* The adjacent-window extension was verified on channel 44.
+ * Channel 149 uses OWL's ordinary social-channel multicast schedule. */
+static inline bool mt7925_extended_discovery(bool fast, uint8_t channel) {
+	return fast && channel == MT7925_DISCOVERY_CHANNEL;
+}
+
+static inline bool mt7925_discovery_is_mdns(const uint8_t *bytes, size_t length) {
+	static const uint8_t mac[] = {0x33, 0x33, 0, 0, 0, 0xfb};
+	static const uint8_t group[16] = {0xff, 0x02, [15] = 0xfb};
+	enum { ethernet_len = 14, ipv6_len = 40, udp_dns_min = 8 + 12 };
+	if (length < ethernet_len + ipv6_len + udp_dns_min ||
+	    memcmp(bytes, mac, sizeof(mac)) || bytes[12] != 0x86 || bytes[13] != 0xdd)
+		return false;
+	const uint8_t *ip = bytes + ethernet_len;
+	const uint8_t *udp = ip + ipv6_len;
+	const size_t payload = ((size_t) ip[4] << 8) | ip[5];
+	return (ip[0] >> 4) == 6 && ip[6] == 17 && !memcmp(ip + 24, group, sizeof(group)) &&
+	       payload >= udp_dns_min && payload == length - ethernet_len - ipv6_len &&
+	       payload == (((size_t) udp[4] << 8) | udp[5]) && udp[2] == 0x14 && udp[3] == 0xe9;
+}
+
+static inline bool mt7925_discovery_fresh(uint64_t now, uint64_t heard) {
+	return heard && now >= heard && now - heard <= MT7925_DISCOVERY_FRESH_US;
+}
+
+static inline bool mt7925_discovery_in_window(unsigned own_channel, unsigned peer_channel, double guard_delay) {
+	return guard_delay == 0 && own_channel == MT7925_DISCOVERY_CHANNEL &&
+	       peer_channel == MT7925_DISCOVERY_CHANNEL;
+}
+
+static inline bool mt7925_discovery_defer_legacy(unsigned peer_count, bool deferred,
+                                                 unsigned peer_channel, unsigned next_own_channel,
+                                                 unsigned next_peer_channel, uint64_t next_guard_us,
+                                                 uint64_t oldest_observation_us) {
+	return peer_count == 1 && !deferred && peer_channel != 0 && peer_channel != 0xff &&
+	       peer_channel != MT7925_DISCOVERY_CHANNEL &&
+	       next_own_channel == MT7925_DISCOVERY_CHANNEL && next_peer_channel == MT7925_DISCOVERY_CHANNEL &&
+	       mt7925_discovery_fresh(next_guard_us, oldest_observation_us);
+}
