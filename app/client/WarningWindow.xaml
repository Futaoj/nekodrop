<Window x:Class="NekoDrop.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="NekoDrop" Width="549" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
  <Grid Margin="22">
    <Border x:Name="Card" Width="505" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
            CornerRadius="13">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.22" Color="#000000"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="4"/>
          <RowDefinition Height="50"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="4" CornerRadius="13,13,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#E8A23A" Offset="0"/>
              <GradientStop Color="#F3C56F" Offset="0.68"/>
              <GradientStop Color="#00FFF4CE" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="HeaderDrag">
              <Border Height="19" CornerRadius="4" Background="#FFF4CE" Padding="7,0" Margin="0,0,8,0"
                      VerticalAlignment="Center">
                <TextBlock x:Name="PillText" FontSize="10.5" FontWeight="SemiBold" Foreground="#8A5200"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TitleButton}" Click="Close_Click" IsCancel="True"
                    Focusable="False" IsTabStop="False"
                    AutomationProperties.Name="{local:T send.close}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <StackPanel Margin="20,16,20,17">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Background="#FFF4CE"
                      VerticalAlignment="Top">
                <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Data="M 3.2,7.2 L 9.0,7.2 L 10.7,9.2 L 20.8,9.2 L 20.8,18.4 C 20.8,19.3 20.1,20 19.2,20 L 4.8,20 C 3.9,20 3.2,19.3 3.2,18.4 L 3.2,8.8 C 3.2,7.9 3.9,7.2 4.8,7.2 Z"
                          Fill="#FBE7A8" Stroke="#9D5D00" StrokeThickness="1.55"/>
                    <Line X1="3.2" Y1="10.1" X2="20.8" Y2="10.1" Stroke="#9D5D00" StrokeThickness="1.2" Opacity="0.35"/>
                    <Ellipse Canvas.Left="12.95" Canvas.Top="11.35" Width="8.3" Height="8.3" Fill="#9D5D00"/>
                    <Line X1="17.1" Y1="13.25" X2="17.1" Y2="16.3" Stroke="#FFF4CE" StrokeThickness="1.55"/>
                    <Ellipse Canvas.Left="16.38" Canvas.Top="17.43" Width="1.44" Height="1.44" Fill="#FFF4CE"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <StackPanel Margin="12,0,0,0">
                <TextBlock x:Name="LeadText" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="21"/>
                <TextBlock x:Name="BodyText" FontSize="11.5" Foreground="{DynamicResource Text2}"
                           TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ConfirmButton" Style="{StaticResource WinPrimary}" Height="31" MinWidth="66"
                    Padding="15,0" FontSize="11.5" IsDefault="True" Click="Close_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
